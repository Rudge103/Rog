-- ===== TOGGLE MAIN GUI VISIBILITY =====
local guiVisible = false

local function toggleGUI()
    guiVisible = not guiVisible
    mainFrame.Visible = guiVisible
    toggleButton.Text = guiVisible and "✕" or "⚡"
    toggleButton.BackgroundColor3 = guiVisible and Color3.fromRGB(180, 60, 60) or Color3.fromRGB(60, 180, 60)
end

toggleButton.Activated:Connect(toggleGUI)

-- ===== DRAGGING (MOBILE + PC) =====
local dragging = false
local dragStart = nil
local startPos = nil

local function startDrag(input)
    dragging = true
    dragStart = input.Position
    startPos = mainFrame.Position
end

local function endDrag()
    dragging = false
    dragStart = nil
    startPos = nil
end

local function updateDrag(input)
    if dragging and dragStart and startPos then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end

-- Start drag on title bar (mouse + touch)
title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        startDrag(input)
    end
end)

-- End drag (mouse/touch release anywhere)
title.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        endDrag()
    end
end)

-- Also end drag if user releases outside title bar
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        endDrag()
    end
end)

-- Move while dragging
UserInputService.InputChanged:Connect(function(input)
    if dragging then
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            updateDrag(input)
        end
    end
end)

-- ===== CORE LOGIC =====
local function resetLock()
    lockTimer = 0
    lockedVelocity = Vector3.zero
    statusLabel.Text = "Status: Idle"
    statusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
end

local function triggerLock(abilityName)
    task.wait(0.05)
    local char = player.Character
    if not char then
        debugLabel.Text = "No char"
        return
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        debugLabel.Text = "No HRP"
        return
    end
    local currentVel = hrp.AssemblyLinearVelocity
    if currentVel.Magnitude > MIN_SPEED then
        lockedVelocity = currentVel
        lockTimer = LOCK_DURATION
        statusLabel.Text = "Locked: " .. string.format("%.0f", lockedVelocity.Magnitude) .. " studs/s"
        statusLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
        debugLabel.Text = abilityName
        print("Velocity locked from", abilityName, "at", lockedVelocity.Magnitude)
    else
        debugLabel.Text = "Speed low: " .. string.format("%.1f", currentVel.Magnitude)
    end
end

local function listenForAbility()
    if not bindableEvent then return end
    bindableEvent.Event:Connect(function(eventType, container, data, metadata)
        if not enabled then return end
        if eventType ~= "spawn" or not container then return end
        local abilityName = container.Name
        local parent = container.Parent
        if parent and parent.Name ~= "Container" and parent.Name ~= "Effect" then
            abilityName = parent.Name .. "." .. abilityName
        end
        if abilityName == "DiamondRework.M1" or abilityName == "Ghoul.Grab" then
            task.spawn(function() triggerLock(abilityName) end)
        end
    end)
end

local function onLoop()
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if lockTimer > 0 then
        hrp.AssemblyLinearVelocity = lockedVelocity
        hrp.AssemblyAngularVelocity = Vector3.zero
        lockTimer = lockTimer - 1/60
        if lockTimer <= 0 then
            resetLock()
        end
    end
end

local function startLoop()
    if connection then return end
    resetLock()
    connection = RunService.Heartbeat:Connect(onLoop)
end

local function stopLoop()
    if connection then
        connection:Disconnect()
        connection = nil
    end
    resetLock()
end

-- ===== TOGGLE LOCK =====
local function toggleLock()
    enabled = not enabled
    toggleBtn.Text = enabled and "LOCK: ON" or "LOCK: OFF"
    toggleBtn.BackgroundColor3 = enabled and Color3.fromRGB(180, 60, 60) or Color3.fromRGB(60, 180, 60)
    if enabled then
        startLoop()
        if bindableEvent then
            listenForAbility()
        else
            warn("No BindableEvent!")
        end
    else
        stopLoop()
    end
end

-- Use Activated for both mouse and touch
toggleBtn.Activated:Connect(toggleLock)

-- ===== KEYBIND (PC) =====
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.K then
        toggleLock()
    end
end)

-- ===== RESPAWN =====
player.CharacterAdded:Connect(function() end)

print("⚡ ROG ON TOP loaded. Tap ⚡ to open GUI, then tap LOCK: OFF to enable.")
