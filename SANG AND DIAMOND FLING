-- VELOCITY LOCK (Triggered by specific moves: Diamond M1 & Ghoul Grab) – ROG ON TOP
-- Tap ⚡ button to open GUI, tap LOCK: OFF to enable.
-- Drag the title bar to move the GUI (touch + mouse).

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer

-- ===== CONFIG =====
local LOCK_DURATION = 0.4
local MIN_SPEED = 2
local enabled = false
local lockedVelocity = Vector3.zero
local lockTimer = 0
local connection = nil

-- ===== FIND THE BINDABLE EVENT =====
local bindableEvent = ReplicatedStorage:FindFirstChild("Effect") and ReplicatedStorage.Effect:FindFirstChild("Bindable")
if not bindableEvent then
    bindableEvent = ReplicatedStorage:WaitForChild("Effect"):WaitForChild("Bindable", 5)
    if not bindableEvent then
        warn("BindableEvent not found!")
    else
        print("Found BindableEvent!")
    end
end

