-- VELOCITY LOCK (Triggered by specific moves: Diamond M1 & Ghoul Grab)
-- Press K to toggle ON/OFF.
-- When ON, using Diamond M1 or Ghoul Grab will lock your velocity for 0.4s.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer

-- ===== CONFIG =====
local LOCK_DURATION = 0.65       -- seconds to keep velocity locked
local MIN_SPEED = 2             -- minimum speed to lock (lowered)
local enabled = false
local lockedVelocity = Vector3.zero
local lockTimer = 0
local connection = nil

-- ===== FIND THE BINDABLE EVENT =====
local bindableEvent = ReplicatedStorage:FindFirstChild("Effect") and ReplicatedStorage.Effect:FindFirstChild("Bindable")
if not bindableEvent then
    warn("Could not find ReplicatedStorage.Effect.Bindable! Trying to wait...")
    bindableEvent = ReplicatedStorage:WaitForChild("Effect"):WaitForChild("Bindable", 5)
    if not bindableEvent then
        warn("Still couldn't find BindableEvent! Script will not work.")
    else
        print("Found BindableEvent!")
    end
end

-- ===== GUI =====
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "VelocityLockGUI"
screenGui.ResetOnSpawn = false
screenGui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 240, 0, 140)
frame.Position = UDim2.new(0.5, -120, 0.3, 0)
