title.BackgroundTransparency = 1
title.Text = "ROG THE GOAT"
title.TextColor3 = Color3.fromRGB(100, 200, 255)
title.Font = Enum.Font.GothamBold
title.TextSize = 18
title.Parent = frame

local toggleBtn = Instance.new("TextButton")
toggleBtn.Size = UDim2.new(0.8, 0, 0, 35)
toggleBtn.Position = UDim2.new(0.1, 0, 0, 40)
toggleBtn.BackgroundColor3 = Color3.fromRGB(60, 180, 60)
toggleBtn.Text = "LOCK: OFF"
toggleBtn.TextColor3 = Color3.new(1, 1, 1)
toggleBtn.Font = Enum.Font.GothamBold
toggleBtn.TextSize = 16
toggleBtn.Parent = frame
Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(0, 8)

local statusLabel = Instance.new("TextLabel")
statusLabel.Size = UDim2.new(1, 0, 0, 20)
statusLabel.Position = UDim2.new(0, 0, 0, 85)
statusLabel.BackgroundTransparency = 1
statusLabel.Text = "Status: Idle"
statusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
statusLabel.Font = Enum.Font.Gotham
statusLabel.TextSize = 13
statusLabel.Parent = frame

local abilityLabel = Instance.new("TextLabel")
abilityLabel.Size = UDim2.new(1, 0, 0, 20)
abilityLabel.Position = UDim2.new(0, 0, 0, 108)
abilityLabel.BackgroundTransparency = 1
abilityLabel.Text = "Listening: Diamond M1 | Ghoul Grab"
abilityLabel.TextColor3 = Color3.fromRGB(150, 150, 180)
abilityLabel.Font = Enum.Font.Gotham
abilityLabel.TextSize = 11
abilityLabel.Parent = frame

-- Debug label (for showing detected abilities)
local debugLabel = Instance.new("TextLabel")
debugLabel.Size = UDim2.new(1, 0, 0, 20)
debugLabel.Position = UDim2.new(0, 0, 0, 125)
debugLabel.BackgroundTransparency = 1
debugLabel.Text = ""
debugLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
debugLabel.Font = Enum.Font.Gotham
debugLabel.TextSize = 10
debugLabel.Parent = frame

-- ===== DRAGGING =====
local dragging = false
local dragStart, startPos

frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

-- ===== CORE LOGIC =====
local function resetLock()
    lockTimer = 0
    lockedVelocity = Vector3.zero
    statusLabel.Text = "Status: Idle"
    statusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
end

local function triggerLock(abilityName)
    -- Delay a tiny bit to let velocity apply
    task.wait(0.05)

    local char = player.Character
    if not char then
        debugLabel.Text = "No character"
        return
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        debugLabel.Text = "No HRP"
        return
    end

    local currentVel = hrp.AssemblyLinearVelocity
    if currentVel.Magnitude > MIN_SPEED then
        lockedVelocity = currentVel
        lockTimer = LOCK_DURATION
        statusLabel.Text = "Locked (" .. abilityName .. "): " .. string.format("%.0f", lockedVelocity.Magnitude) .. " studs/s"
        statusLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
        debugLabel.Text = "TRIGGERED: " .. abilityName
        print("Velocity locked from", abilityName, "at", lockedVelocity.Magnitude, "for", LOCK_DURATION, "s")
    else
        debugLabel.Text = "Ability detected but speed too low: " .. string.format("%.1f", currentVel.Magnitude)
        print("Ability detected but speed too low:", currentVel.Magnitude)
    end
end

-- ===== EVENT LISTENER =====
local function listenForAbility()
    if not bindableEvent then
        warn("BindableEvent not found!")
        return
    end

    bindableEvent.Event:Connect(function(eventType, container, data, metadata)
        if not enabled then
            return
        end

        if eventType ~= "spawn" then
            return
        end
        if not container then
            return
        end

        -- Get the full ability name
        local abilityName = container.Name
        local parent = container.Parent
        if parent and parent.Name ~= "Container" and parent.Name ~= "Effect" then
            abilityName = parent.Name .. "." .. abilityName
        end

        -- Check for the specific abilities
        if abilityName == "DiamondRework.M1" or abilityName == "Ghoul.Grab" then
            print("MATCHED! Triggering lock for:", abilityName)
            -- Spawn a thread to handle the delay and lock
            task.spawn(function()
                triggerLock(abilityName)
            end)
        end
    end)
end

-- ===== LOOP FOR APPLYING LOCK =====
local function onLoop()
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if lockTimer > 0 then
        hrp.AssemblyLinearVelocity = lockedVelocity
        hrp.AssemblyAngularVelocity = Vector3.zero
        lockTimer = lockTimer - 1/60
        if lockTimer <= 0 then
            resetLock()
        end
    end
end

local function startLoop()
    if connection then return end
    resetLock()
    connection = RunService.Heartbeat:Connect(onLoop)
end

local function stopLoop()
    if connection then
        connection:Disconnect()
        connection = nil
    end
    resetLock()
end

-- ===== TOGGLE =====
local function toggleLock()
    enabled = not enabled
    toggleBtn.Text = enabled and "LOCK: ON" or "LOCK: OFF"
    toggleBtn.BackgroundColor3 = enabled and Color3.fromRGB(180, 60, 60) or Color3.fromRGB(60, 180, 60)
    if enabled then
        startLoop()
        if bindableEvent then
            listenForAbility()
        else
            warn("No BindableEvent available!")
        end
    else
        stopLoop()
    end
end

toggleBtn.MouseButton1Click:Connect(toggleLock)

-- ===== KEYBIND =====
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.K then
        toggleLock()
    end
end)

print("⚡ Move Lock loaded. Press K to toggle.")
print("   Listens for: DiamondRework.M1 | Ghoul.Grab")
