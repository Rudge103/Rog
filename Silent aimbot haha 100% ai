-- SILENT AIMBOT (Players + NPCs) – Tiny GUI, Accurate FOV
-- Standard weapons + Skull Guitar TAP (with Validator2) both working.

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer
local Mouse = LocalPlayer:GetMouse()
local Camera = Workspace.CurrentCamera
local circle = Drawing.new("Circle")

-- ===== CONFIGURATION =====
if not getgenv().setting then
    getgenv().setting = {
        Fov = 110,
        Color = Color3.fromRGB(255, 0, 0),
    }
end

-- ===== GUI CONTROLS =====
local AimbotEnabled = true
local TargetMode = "Both"

-- ===== TARGET VARIABLES =====
local Playersaimbot = nil
local PlayersPosition = nil
local NPCTargetPart = nil

-- ===== FOV CIRCLE =====
local function updateCircle()
    if circle.__OBJECT_EXISTS then
        circle.Transparency = 0.4
        circle.Visible = true
        circle.Thickness = 2
        circle.Color = getgenv().setting.Color
        circle.NumSides = 100
        circle.Radius = (getgenv().setting.Fov * 6 - 8) / 2
        circle.Filled = false
        circle.Position = Vector2.new(Mouse.X, Mouse.Y + (GuiService:GetGuiInset().Y))
    end
end
RunService.RenderStepped:Connect(updateCircle)

-- ===== NPC HELPER =====
local function getNPCs()
    local npcs = {}
    local enemiesFolder = Workspace:FindFirstChild("Enemies")
    if enemiesFolder then
        for _, obj in ipairs(enemiesFolder:GetChildren()) do
            local hum = obj:FindFirstChildWhichIsA("Humanoid")
            if hum and hum.Health > 0 then
                local root = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")
                if root then
                    table.insert(npcs, root)
                end
            end
        end
    end
    return npcs
end

-- ===== TARGET SELECTION LOOP =====
spawn(function()
    pcall(function()
        while wait() do
            if not AimbotEnabled then
                Playersaimbot = nil
                NPCTargetPart = nil
                PlayersPosition = nil
                continue
            end

            local bestPlayerName = nil
            local bestPlayerPos = nil
            local bestNPC = nil
            local bestNPCPos = nil
            local bestPlayerDist = math.huge
            local bestNPCDist = math.huge
            local fovRadius = (getgenv().setting.Fov * 6 - 8) / 2

            -- Players
            if TargetMode == "Players" or TargetMode == "Both" then
                for _, v in ipairs(Players:GetPlayers()) do
                    if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
                        local root = v.Character.HumanoidRootPart
                        local pos = Camera:WorldToViewportPoint(root.Position)
                        local magnitude = (Vector2.new(pos.X, pos.Y) - Vector2.new(Mouse.X, Mouse.Y)).magnitude
                        if magnitude < fovRadius and magnitude < bestPlayerDist then
                            local worldDist = (root.Position - LocalPlayer.Character.HumanoidRootPart.Position).magnitude
                            if worldDist <= 1000 then
                                bestPlayerDist = magnitude
                                bestPlayerName = v.Name
                                bestPlayerPos = root.Position
                            end
                        end
                    end
                end
            end

            -- NPCs
            if TargetMode == "NPCs" or TargetMode == "Both" then
                for _, part in ipairs(getNPCs()) do
                    local pos = Camera:WorldToViewportPoint(part.Position)
                    local magnitude = (Vector2.new(pos.X, pos.Y) - Vector2.new(Mouse.X, Mouse.Y)).magnitude
                    if magnitude < fovRadius and magnitude < bestNPCDist then
                        local worldDist = (part.Position - LocalPlayer.Character.HumanoidRootPart.Position).magnitude
                        if worldDist <= 1000 then
                            bestNPCDist = magnitude
                            bestNPC = part
                            bestNPCPos = part.Position
                        end
                    end
                end
            end

            if bestPlayerName then
                Playersaimbot = bestPlayerName
                NPCTargetPart = nil
                PlayersPosition = bestPlayerPos
            elseif bestNPC then
                Playersaimbot = nil
                NPCTargetPart = bestNPC
                PlayersPosition = bestNPCPos
            else
                Playersaimbot = nil
                NPCTargetPart = nil
                PlayersPosition = nil
            end
        end
    end)
end)

-- ===== UPDATE TARGET POSITION =====
spawn(function()
    while wait() do
        if Playersaimbot then
            local plr = Players:FindFirstChild(Playersaimbot)
            if plr and plr.Character then
                local root = plr.Character:FindFirstChild("HumanoidRootPart")
                if root then
                    PlayersPosition = root.Position
                end
            end
        elseif NPCTargetPart and NPCTargetPart.Parent then
            PlayersPosition = NPCTargetPart.Position
        else
            Playersaimbot = nil
            NPCTargetPart = nil
            PlayersPosition = nil
        end
    end
end)

-- ===== FIND SKULL GUITAR REMOTE =====
local skullGuitarRemote = nil

local function findSkullGuitarRemote()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        local tool = backpack:FindFirstChild("Skull Guitar")
        if tool then
            local remote = tool:FindFirstChild("RemoteEvent")
            if remote then
                skullGuitarRemote = remote
                return
            end
        end
    end
    local char = LocalPlayer.Character
    if char then
        local tool = char:FindFirstChild("Skull Guitar")
        if tool then
            local remote = tool:FindFirstChild("RemoteEvent")
            if remote then
                skullGuitarRemote = remote
                return
            end
        end
    end
    skullGuitarRemote = nil
end

findSkullGuitarRemote()

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    findSkullGuitarRemote()
end)

LocalPlayer.Backpack.ChildAdded:Connect(function(child)
    if child.Name == "Skull Guitar" then
        task.wait(0.1)
        findSkullGuitarRemote()
    end
end)

-- ===== REMOTE HOOK (Standard + Skull Guitar) =====
spawn(function()
    local gg = getrawmetatable(game)
    local old = gg.__namecall
    setreadonly(gg, false)
    gg.__namecall = newcclosure(function(...)
        local method = getnamecallmethod()
        local args = {...}
        if tostring(method) == "FireServer" then
            -- Only intercept if the first argument is a RemoteEvent (standard filter)
            if tostring(args[1]) == "RemoteEvent" then
                -- ===== SKULL GUITAR "TAP" (special case) =====
                if skullGuitarRemote and rawequal(args[1], skullGuitarRemote) then
                    -- Check if the first actual argument is "TAP" and second is Vector3
                    if tostring(args[2]) == "TAP" and typeof(args[3]) == "Vector3" then
                        -- Fire Validator2 first
                        local validator = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Validator2")
                        if validator then
                            pcall(function()
                                validator:FireServer(950989, 11)
                            end)
                        end
                        -- Replace the vector with target position if locked
                        if PlayersPosition then
                            args[3] = PlayersPosition
                            return old(unpack(args))
                        else
                            return old(...)
                        end
                    end
                end

                -- ===== STANDARD WEAPONS =====
                -- If the first actual argument is a Vector3 (not a boolean), replace it with target position
                if typeof(args[2]) == "Vector3" and tostring(args[2]) ~= "true" and tostring(args[2]) ~= "false" then
                    if PlayersPosition then
                        args[2] = PlayersPosition
                        return old(unpack(args))
                    end
                end
            end
        end
        return old(...)
    end)
end)

-- ===== LEFT CLICK HANDLER (for RemoteFunctionShoot) =====
Mouse.Button1Down:Connect(function()
    pcall(function()
        if PlayersPosition then
            local targetPart = nil
            if Playersaimbot then
                local plr = Players:FindFirstChild(Playersaimbot)
                if plr and plr.Character then
                    targetPart = plr.Character:FindFirstChild("HumanoidRootPart")
                end
            elseif NPCTargetPart then
                targetPart = NPCTargetPart
            end
            if targetPart then
                local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
                if tool and tool:FindFirstChild("RemoteFunctionShoot") then
                    tool.RemoteFunctionShoot:InvokeServer(PlayersPosition, targetPart)
                end
            end
        end
    end)
end)

