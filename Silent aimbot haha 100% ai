-- SILENT AIMBOT (Remote Hook + Mouse Hook) + SMOOTH STICK
-- Hold G to stick, release G to press Z.
-- Works with ALL weapons: guns (Mouse.Hit) and remote-based weapons.

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualInput = game:GetService("VirtualInputManager")
local LocalPlayer = Players.LocalPlayer
local Mouse = LocalPlayer:GetMouse()
local Camera = Workspace.CurrentCamera
local circle = Drawing.new("Circle")

-- ===== LINE INDICATOR =====
local aimLine = Drawing.new("Line")
aimLine.Visible = false
aimLine.Color = Color3.fromRGB(0, 0, 0)
aimLine.Thickness = 2
aimLine.Transparency = 0.6

-- ===== CONFIGURATION =====
if not getgenv().setting then
    getgenv().setting = {
        Fov = 150,
        Color = Color3.fromRGB(255, 0, 0),
    }
end

-- ===== PREDICTION SETTINGS =====
local PREDICTION_ENABLED = true
local PREDICTION_MAX_TIME = 0.675
local PREDICTION_SCALE = 0.025
local PREDICTION_MIN_SPEED = 2.5
local SMOOTH_FACTOR = 0.7

-- ===== STICK SETTINGS =====
local STICK_OFFSET = Vector3.new(0, 3, 0)          -- base hover offset
local STICK_SMOOTHING = 0.3                       -- interpolation speed (0.1–0.5)
local STICK_PREDICTION_ENABLED = true
local STICK_PREDICTION_TIME = 0.15               -- seconds ahead to lead the target

-- ===== TARGETING =====
local MAX_WORLD_DIST = 800
local SCORE_WEIGHT = 0.05

-- ===== GUI CONTROLS =====
local AimbotEnabled = true
local TargetMode = "Both"

-- ===== TARGET VARIABLES =====
local Playersaimbot = nil
local PlayersPosition = nil      -- predicted position (for remotes)
local CurrentTargetPosition = nil -- actual position (for Mouse.Hit)
local NPCTargetPart = nil
local TargetVelocity = nil
local lastPredictedPos = nil

-- ===== LOCKED TARGET =====
local lockedPlayerName = nil
local lockedNPCPart = nil
local stickingEnabled = false

-- ===== FOV CIRCLE =====
local function updateCircle()
    if circle.__OBJECT_EXISTS then
        circle.Transparency = 0.4
        circle.Visible = true
        circle.Thickness = 2
        circle.Color = getgenv().setting.Color
        circle.NumSides = 100
        circle.Radius = (getgenv().setting.Fov * 6 - 8) / 2
        circle.Filled = false
        circle.Position = Vector2.new(Mouse.X, Mouse.Y + (GuiService:GetGuiInset().Y))
    end
end

-- ===== UPDATE AIM LINE =====
local function updateAimLine()
    if not AimbotEnabled or not CurrentTargetPosition then
        aimLine.Visible = false
        return
    end

    local screenPos, onScreen = Camera:WorldToViewportPoint(CurrentTargetPosition)
    if not onScreen then
        aimLine.Visible = false
        return
    end

    local bottomCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
    aimLine.From = bottomCenter
    aimLine.To = Vector2.new(screenPos.X, screenPos.Y)
    aimLine.Visible = true
end

-- ===== NPC HELPER =====
local function getNPCs()
    local npcs = {}
    local enemiesFolder = Workspace:FindFirstChild("Enemies")
    if enemiesFolder then
        for _, obj in ipairs(enemiesFolder:GetChildren()) do
            local hum = obj:FindFirstChildWhichIsA("Humanoid")
            if hum and hum.Health > 0 then
                local root = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")
                if root then
                    table.insert(npcs, root)
                end
            end
        end
    end
    return npcs
end

-- ===== TARGET SELECTION LOOP =====
spawn(function()
    pcall(function()
        while wait() do
            if not AimbotEnabled then
                Playersaimbot = nil
                NPCTargetPart = nil
                PlayersPosition = nil
                CurrentTargetPosition = nil
                TargetVelocity = nil
                lastPredictedPos = nil
                continue
            end

            local bestPlayerName = nil
            local bestPlayerPos = nil
            local bestNPC = nil
            local bestNPCPos = nil
            local bestScore = math.huge
            local fovRadius = (getgenv().setting.Fov * 6 - 8) / 2

            local function evaluateCandidate(root, isPlayer, name)
                local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
                if not onScreen then return end
                local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(Mouse.X, Mouse.Y)).magnitude
                if screenDist > fovRadius then return end
                local worldDist = (root.Position - LocalPlayer.Character.HumanoidRootPart.Position).magnitude
                if worldDist > MAX_WORLD_DIST then return end
                local score = screenDist + worldDist * SCORE_WEIGHT
                if score < bestScore then
                    bestScore = score
                    if isPlayer then
                        bestPlayerName = name
                        bestPlayerPos = root.Position
                        TargetVelocity = root.AssemblyLinearVelocity
                    else
                        bestNPC = root
                        bestNPCPos = root.Position
                        TargetVelocity = root.AssemblyLinearVelocity
                    end
                end
            end

            if TargetMode == "Players" or TargetMode == "Both" then
                for _, v in ipairs(Players:GetPlayers()) do
                    if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
                        local root = v.Character.HumanoidRootPart
                        evaluateCandidate(root, true, v.Name)
                    end
                end
            end

            if TargetMode == "NPCs" or TargetMode == "Both" then
                for _, part in ipairs(getNPCs()) do
                    evaluateCandidate(part, false, nil)
                end
            end

            if bestPlayerName then
                Playersaimbot = bestPlayerName
                NPCTargetPart = nil
                CurrentTargetPosition = bestPlayerPos
                PlayersPosition = bestPlayerPos
            elseif bestNPC then
                Playersaimbot = nil
                NPCTargetPart = bestNPC
                CurrentTargetPosition = bestNPCPos
                PlayersPosition = bestNPCPos
            else
                Playersaimbot = nil
                NPCTargetPart = nil
                PlayersPosition = nil
                CurrentTargetPosition = nil
                TargetVelocity = nil
                lastPredictedPos = nil
            end
        end
    end)
end)

-- ===== UPDATE TARGET POSITION (prediction for remotes) =====
spawn(function()
    while wait() do
        if Playersaimbot then
            local plr = Players:FindFirstChild(Playersaimbot)
            if plr and plr.Character then
                local root = plr.Character:FindFirstChild("HumanoidRootPart")
                if root then
                    local currentPos = root.Position
                    CurrentTargetPosition = currentPos
                    if PREDICTION_ENABLED and TargetVelocity then
                        local speed = TargetVelocity.Magnitude
                        if speed > PREDICTION_MIN_SPEED then
                            local predTime = math.min(speed * PREDICTION_SCALE, PREDICTION_MAX_TIME)
                            local predicted = currentPos + TargetVelocity * predTime
                            if lastPredictedPos then
                                predicted = lastPredictedPos * (1 - SMOOTH_FACTOR) + predicted * SMOOTH_FACTOR
                            end
                            lastPredictedPos = predicted
                            PlayersPosition = predicted
                        else
                            lastPredictedPos = nil
                            PlayersPosition = currentPos
                        end
                    else
                        lastPredictedPos = nil
                        PlayersPosition = currentPos
                    end
                    TargetVelocity = root.AssemblyLinearVelocity
                end
            end
        elseif NPCTargetPart and NPCTargetPart.Parent then
            local currentPos = NPCTargetPart.Position
            CurrentTargetPosition = currentPos
            if PREDICTION_ENABLED and TargetVelocity then
                local speed = TargetVelocity.Magnitude
                if speed > PREDICTION_MIN_SPEED then
                    local predTime = math.min(speed * PREDICTION_SCALE, PREDICTION_MAX_TIME)
                    local predicted = currentPos + TargetVelocity * predTime
                    if lastPredictedPos then
                        predicted = lastPredictedPos * (1 - SMOOTH_FACTOR) + predicted * SMOOTH_FACTOR
                    end
                    lastPredictedPos = predicted
                    PlayersPosition = predicted
                else
                    lastPredictedPos = nil
                    PlayersPosition = currentPos
                end
            else
                lastPredictedPos = nil
                PlayersPosition = currentPos
            end
            TargetVelocity = NPCTargetPart.AssemblyLinearVelocity
        else
            Playersaimbot = nil
            NPCTargetPart = nil
            PlayersPosition = nil
            CurrentTargetPosition = nil
            TargetVelocity = nil
            lastPredictedPos = nil
        end
    end
end)

-- ===== STICKING LOOP (SMOOTH + PREDICTION) =====
spawn(function()
    while wait() do
        if not stickingEnabled or not AimbotEnabled then
            continue
        end
        local targetRoot = nil
        if lockedPlayerName then
            local plr = Players:FindFirstChild(lockedPlayerName)
            if plr and plr.Character then
                targetRoot = plr.Character:FindFirstChild("HumanoidRootPart")
            end
        elseif lockedNPCPart and lockedNPCPart.Parent then
            targetRoot = lockedNPCPart
        end
        if targetRoot and targetRoot.Parent then
            local char = LocalPlayer.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local targetPos = targetRoot.Position + STICK_OFFSET
                    if STICK_PREDICTION_ENABLED then
                        local vel = targetRoot.AssemblyLinearVelocity
                        if vel and vel.Magnitude > 0.5 then
                            targetPos = targetPos + vel * STICK_PREDICTION_TIME
                        end
                    end
                    local targetCF = CFrame.new(targetPos)
                    hrp.CFrame = hrp.CFrame:Lerp(targetCF, STICK_SMOOTHING)
                    hrp.Velocity = Vector3.zero
                    hrp.RotVelocity = Vector3.zero
                end
            end
        end
    end
end)

-- ===== KEY HANDLERS =====
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.G then
        lockedPlayerName = Playersaimbot
        lockedNPCPart = NPCTargetPart
        stickingEnabled = true
        print("Locked target:", lockedPlayerName or (lockedNPCPart and lockedNPCPart.Parent.Name) or "None")
    end
end)

UserInputService.InputEnded:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.G then
        stickingEnabled = false
        lockedPlayerName = nil
        lockedNPCPart = nil
        -- Press Z key (down then up)
        VirtualInput:SendKeyEvent(true, Enum.KeyCode.Z, false, nil)
        task.wait(0.05)
        VirtualInput:SendKeyEvent(false, Enum.KeyCode.Z, false, nil)
        print("Pressed Z on release of G")
    end
end)

-- ===== REMOTE HOOK (for Skull Guitar and generic remotes) =====
local skullGuitarRemote = nil

local function findSkullGuitarRemote()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        local tool = backpack:FindFirstChild("Skull Guitar")
        if tool then
            local remote = tool:FindFirstChild("RemoteEvent")
            if remote then
                skullGuitarRemote = remote
                return
            end
        end
    end
    local char = LocalPlayer.Character
    if char then
        local tool = char:FindFirstChild("Skull Guitar")
        if tool then
            local remote = tool:FindFirstChild("RemoteEvent")
            if remote then
                skullGuitarRemote = remote
                return
            end
        end
    end
    skullGuitarRemote = nil
end

findSkullGuitarRemote()

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    findSkullGuitarRemote()
end)

LocalPlayer.Backpack.ChildAdded:Connect(function(child)
    if child.Name == "Skull Guitar" then
        task.wait(0.1)
        findSkullGuitarRemote()
    end
end)

spawn(function()
    local gg = getrawmetatable(game)
    local old = gg.__namecall
    setreadonly(gg, false)
    gg.__namecall = newcclosure(function(...)
        local method = getnamecallmethod()
        local args = {...}
        if tostring(method) == "FireServer" then
            if tostring(args[1]) == "RemoteEvent" then
                if skullGuitarRemote and rawequal(args[1], skullGuitarRemote) then
                    if tostring(args[2]) == "TAP" and typeof(args[3]) == "Vector3" then
                        local validator = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Validator2")
                        if validator then
                            pcall(function()
                                validator:FireServer(950989, 11)
                            end)
                        end
                        if PlayersPosition then
                            args[3] = PlayersPosition
                            return old(unpack(args))
                        else
                            return old(...)
                        end
                    end
                end

                if typeof(args[2]) == "Vector3" and tostring(args[2]) ~= "true" and tostring(args[2]) ~= "false" then
                    if PlayersPosition then
                        args[2] = PlayersPosition
                        return old(unpack(args))
                    end
                end
            end
        end
        return old(...)
    end)
end)

-- ===== MOUSE METATABLE HOOK (for guns that use Mouse.Hit) =====
local oldIndex
local mouseMetatable = getrawmetatable(Mouse)
if mouseMetatable then
    oldIndex = mouseMetatable.__index
    setreadonly(mouseMetatable, false)
    mouseMetatable.__index = newcclosure(function(self, key)
        -- Always redirect if aimbot is enabled and we have a target
        if AimbotEnabled and CurrentTargetPosition then
            if key == "Hit" then
                -- Use the actual (non-predicted) position for accurate shooting
                return CFrame.new(CurrentTargetPosition)
            elseif key == "Target" then
                -- Return the actual BasePart (torso) if available
                local targetRoot = nil
                if lockedPlayerName then
                    local plr = Players:FindFirstChild(lockedPlayerName)
                    if plr and plr.Character then
                        targetRoot = plr.Character:FindFirstChild("HumanoidRootPart")
                    end
                elseif lockedNPCPart and lockedNPCPart.Parent then
                    targetRoot = lockedNPCPart
                end
                if targetRoot then
                    return targetRoot
                end
            end
        end
        return oldIndex(self, key)
    end)
    setreadonly(mouseMetatable, true)
    print("Mouse property hook installed (silent, torso).")
else
    warn("Could not hook Mouse metatable.")
end

-- ===== LEFT CLICK HANDLER (for weapons using RemoteFunctionShoot) =====
Mouse.Button1Down:Connect(function()
    pcall(function()
        if PlayersPosition then
            local targetPart = nil
            if Playersaimbot then
                local plr = Players:FindFirstChild(Playersaimbot)
                if plr and plr.Character then
                    targetPart = plr.Character:FindFirstChild("HumanoidRootPart")
                end
            elseif NPCTargetPart then
                targetPart = NPCTargetPart
            end
            if targetPart then
                local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
                if tool and tool:FindFirstChild("RemoteFunctionShoot") then
                    tool.RemoteFunctionShoot:InvokeServer(PlayersPosition, targetPart)
                end
            end
        end
    end)
end)

